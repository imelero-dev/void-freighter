# Copy to .env and fill in before `docker compose up`.

# Postgres password for the voidfreighter database user.
POSTGRES_PASSWORD=change-me

# Optional overrides:
# PORT=8788
# DATABASE_URL=postgres://voidfreighter:password@localhost:5434/voidfreighter
# ALLOW_DEV_COMMANDS=1     # test bots only — NEVER in production
# TRUSTED_PROXY_IPS=10.0.0.1
